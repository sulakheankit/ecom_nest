[build]
command = "npm run build -w frontend"
publish = "frontend/dist"

[[redirects]]
from = "/api/*"
to = "https://YOUR-BACKEND-HOST/api/:splat"
status = 200
force = true

[[redirects]]
from = "/uploads/*"
to = "https://YOUR-BACKEND-HOST/uploads/:splat"
status = 200
force = true

[[redirects]]
from = "/sitemap.xml"
to = "https://YOUR-BACKEND-HOST/sitemap.xml"
status = 200
force = true

[[redirects]]
from = "/robots.txt"
to = "https://YOUR-BACKEND-HOST/robots.txt"
status = 200
force = true

[[redirects]]
from = "/*"
to = "/index.html"
status = 200
