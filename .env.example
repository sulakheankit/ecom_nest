DATABASE_URL=postgresql://nest:nest@localhost:5432/nest
# Use embedded PostgreSQL for a zero-service local demonstration only.
DB_MODE=postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=5000
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
DB_SSL=false
# Optional trusted Supabase CA certificate, with literal \n between lines.
DB_SSL_CA=
TRUST_PROXY=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nest-images
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
