{
  "name": "nest-ecommerce",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w frontend && npm run build -w backend",
    "test": "npm run test:backend && npm run test:frontend",
    "db:migrate": "node --import tsx database/migrate.ts",
    "db:seed": "node --import tsx database/seed/index.ts",
    "start": "npm run start -w backend",
    "test:backend": "node --import tsx --test tests/backend.test.ts",
    "test:frontend": "vitest run",
    "setup:demo": "node scripts/setup-demo.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.1",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
